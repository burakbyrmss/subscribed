{
  "name": "subnote",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "react-native start",
    "start:cache": "react-native start --reset-cache",
    "start:expo": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "bump-version": "node ./scripts/bump-version.js",
    "bump-build": "node ./scripts/bump-build.js",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "android:expo": "expo run:android",
    "ios:expo": "expo start --ios --localhost",
    "web:expo": "expo start --web",
    "lint": "expo lint",
    "ios:pods": "cd ios && pod install && cd ..",
    "ios:clean": "xcodebuild -workspace ios/subnote.xcworkspace -scheme subnote -configuration Release clean",
    "ios:archive": "mkdir -p ios/build && xcodebuild -workspace ios/subnote.xcworkspace -scheme subnote -configuration Release -sdk iphoneos -archivePath ios/build/subnote.xcarchive archive",
    "ios:export": "xcodebuild -allowProvisioningUpdates -exportArchive -archivePath ios/build/subnote.xcarchive -exportPath ios/build/export -exportOptionsPlist ios/exportOptions.appstore.plist",
    "ios:ipa": "npm run ios:archive && npm run ios:export",
    "ios:open:outputs": "open ios/build || true",
    "android:clean": "cd android && ./gradlew clean",
    "android:aab": "cd android && ./gradlew bundleRelease",
    "android:apk": "cd android && ./gradlew assembleRelease",
    "android:open:outputs": "open android/app/build/outputs || true"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "dayjs": "^1.11.19",
    "expo": "~54.0.27",
    "expo-constants": "~18.0.11",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.20",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.10",
    "expo-notifications": "~0.32.14",
    "expo-router": "~6.0.17",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "i18next": "^25.8.0",
    "intl-pluralrules": "^2.0.1",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.66.0",
    "react-i18next": "^16.5.3",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-iap": "^14.7.7",
    "react-native-localize": "^3.6.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.1.0",
    "@react-native/metro-config": "^0.83.1",
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
